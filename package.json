{
  "name": "payroll-ordonnanceur",
  "version": "1.0.0",
  "private": true,
  "description": "Off-chain scheduler that triggers on-chain payroll execution",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tick": "tsx src/index.ts",
    "verify:abi": "tsx scripts/verify-abi.mts",
    "probe": "tsx scripts/probe.mts",
    "recap": "tsx scripts/recap.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "resend": "^4.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
