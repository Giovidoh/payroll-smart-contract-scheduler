# ---------------------------------------------------------------------------
# Chain connection
# ---------------------------------------------------------------------------
# Sepolia RPC endpoint (Alchemy, Infura, or any provider)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key

# Address of the deployed Payroll contract
PAYROLL_ADDRESS=0x0000000000000000000000000000000000000000

# Private key of the scheduler account.
# This account is NOT the contract owner and holds no privilege: it only pays
# gas. Use a dedicated throwaway key. Never commit this file.
# node -e "const {generatePrivateKey,privateKeyToAccount}=require('viem/accounts');const fs=require('fs');const k=generatePrivateKey();fs.writeFileSync('.env',fs.readFileSync('.env','utf8').replace(/^SCHEDULER_PRIVATE_KEY=.*$/m,'SCHEDULER_PRIVATE_KEY='+k));console.log('Adresse ordonnanceur :',privateKeyToAccount(k).address)"
SCHEDULER_PRIVATE_KEY=0x...

# Blocks to wait before treating the payroll transaction as final
CONFIRMATIONS=2

# Warn below this balance, in wei (default 0.01 ETH)
MIN_GAS_BALANCE_WEI=10000000000000000

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
RESEND_API_KEY=re_...
ALERT_FROM=ordonnanceur@votre-domaine.com
ALERT_TO=employeur@example.com

# UTC hours during which alerts may be sent. Bounds the number of emails
# without keeping any state between runs.
ALERT_HOURS_UTC=8,20
